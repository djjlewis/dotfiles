#!/bin/sh

set -eu

AEROSPACE_BIN="${AEROSPACE_BIN:-aerospace}"

usage() {
    echo "Usage: $0 (workspace 0-9 | move 0-9 | other workspace|move [0-9] | next | prev)" >&2
    exit 2
}

focused_workspace() {
    "$AEROSPACE_BIN" list-workspaces --focused --format '%{workspace}'
}

current_group() {
    case "$1" in
        P[0-9]) echo P ;;
        W[0-9]) echo W ;;
        *) echo P ;;
    esac
}

other_group() {
    case "$(current_group "$1")" in
        P) echo W ;;
        *) echo P ;;
    esac
}

current_slot() {
    case "$1" in
        [CPW][0-9]) printf '%s\n' "${1#?}" ;;
        [0-9]) printf '%s\n' "$1" ;;
        *) echo 0 ;;
    esac
}

action="${1:-}"
value="${2:-}"
slot="${3:-}"

case "$action" in
    workspace|move)
        case "$value" in
            [0-9]) ;;
            *) usage ;;
        esac
        workspace="$(focused_workspace)"
        target="$(current_group "$workspace")${value}"
        if [ "$action" = workspace ]; then
            exec "$AEROSPACE_BIN" workspace "$target"
        else
            exec "$AEROSPACE_BIN" move-node-to-workspace "$target"
        fi
        ;;
    next|prev)
        workspace="$(focused_workspace)"
        # Slots run 1 to 9 then 0, the order of the number row, and wrap.
        index=$(( ($(current_slot "$workspace") + 9) % 10 ))
        if [ "$action" = next ]; then
            index=$(( (index + 1) % 10 ))
        else
            index=$(( (index + 9) % 10 ))
        fi
        exec "$AEROSPACE_BIN" workspace "$(current_group "$workspace")$(( (index + 1) % 10 ))"
        ;;
    other)
        case "$value" in
            workspace|move) ;;
            *) usage ;;
        esac
        workspace="$(focused_workspace)"
        # No slot given means the same slot in the other bank.
        case "$slot" in
            '') slot="$(current_slot "$workspace")" ;;
            [0-9]) ;;
            *) usage ;;
        esac
        target="$(other_group "$workspace")${slot}"
        if [ "$value" = workspace ]; then
            exec "$AEROSPACE_BIN" workspace "$target"
        else
            # Crossing banks follows the window. Within a bank it does not.
            exec "$AEROSPACE_BIN" move-node-to-workspace --focus-follows-window "$target"
        fi
        ;;
    *)
        usage
        ;;
esac
