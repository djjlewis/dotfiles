# Azure and .NET. The work profile installs this group.
# Install with: brew bundle --file brew/Brewfile.cloud

tap "azure/azd" # Microsoft's tap; `brew install azure/azd/azd` is the install its docs give

brew "azure-cli"
cask "azure/azd/azd", trusted: true # provides azd. The tap also has a formula, but Microsoft upgrades the cask
cask "dotnet-sdk"
cask "microsoft-edge" # the browser the Azure portal signs in to cleanly
