[user]
	email = dan@daniellewis.dev
	name = Dan Lewis
[includeIf "gitdir:~/projects/aos/"]
    path = ~/.gitconfig-work
[includeIf "gitdir:~/projects/personal/"]
	path = ~/.gitconfig-personal
[includeIf "gitdir:~/.dotfiles/"]
	path = ~/.gitconfig-personal
[core]
	editor = nvim
	autocrlf = input
	excludesfile = ~/.gitignore_global
	pager = diff-so-fancy | less -RFX
[diff]
	tool = vimdiff
[alias]
	co = checkout
	st = status
	br = branch
	ci = commit
	ignore = update-index --skip-worktree
	unignore = update-index --no-skip-worktree
	ignored = !git ls-files -v | grep \"^S\"
        l1 = log --pretty=format:"%C(yellow)%h\\ %ad%Cred%d\\ %Creset%s%Cblue\\ [%cn]" --decorate --date=short
        l2 = log --graph --oneline --decorate --all
	rpo = remote prune origin

[color]
	status = always
[merge]
	tool = vimdiff
[pull]
	ff = only
[init]
	defaultBranch = main
# Credential helpers are OS-specific, so they live in ~/.gitconfig-local
# rather than here. This file is stowed on every machine; that one is not in
# the repo, and git ignores the include when the file is absent.
#   macOS: helper = osxkeychain
#   Arch:  helper = libsecret  (install: pacman -S libsecret + git-credential-libsecret)
#   Other: helper = cache --timeout=3600
# `gh auth setup-git` writes an absolute path to the gh binary into whichever
# file it finds first, which is this one. Move what it writes into
# ~/.gitconfig-local, or Linux inherits a Homebrew path that does not exist.
[include]
	path = ~/.gitconfig-local
